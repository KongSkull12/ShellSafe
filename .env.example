# ShellSafe environment variables
# Copy to .env and fill in real values. Never commit .env.

# Flask session signing (required on Vercel; optional locally)
SECRET_KEY=

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com/

# Option A (Vercel / cloud): paste the full service-account JSON as one line
FIREBASE_CREDENTIALS_JSON=

# Option B (local): path to the downloaded service account file
# FIREBASE_KEY_PATH=./serviceAccountKey.json

# Create users once: python -m flask create-users
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTHORITY_EMAIL=
AUTHORITY_PASSWORD=

# Optional tuning
# SENSOR_SAMPLER=1
# DEVICE_OFFLINE_TIMEOUT_SECONDS=90
# SENSOR_CACHE_TTL_SECONDS=2.5
# SENSOR_HISTORY_SAMPLES=720
